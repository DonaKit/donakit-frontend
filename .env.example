# URL pública del backend en NestJS (por defecto apunta a Render si no se define)
NEXT_PUBLIC_API_URL=

# Secreto de Auth.js (NextAuth v5) para cifrar las cookies de sesión
AUTH_SECRET=

# Secreto compartido con el backend NestJS para firmar JWTs administrativos HS256
# (Si no se define, usa AUTH_SECRET como respaldo)
JWT_SECRET=

# Credenciales OAuth de Google (Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Lista de correos electrónicos autorizados como administradores (separados por comas)
ADMIN_EMAILS=

